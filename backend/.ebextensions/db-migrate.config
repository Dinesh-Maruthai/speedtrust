container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate"
    leader_only: true
  02_create_superuser:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py shell -c \"from django.contrib.auth.models import User; User.objects.filter(username='admin').exists() or User.objects.create_superuser('admin', 'admin@speedtrust.org', 'SpeedTrust2026!')\""
    leader_only: true
    ignoreErrors: true
